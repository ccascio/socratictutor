{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SocraticTutor",
  "version": "0.1.0",
  "identifier": "app.socratictutor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SocraticTutor",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "dragDropEnabled": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Education",
    "shortDescription": "AI-powered Socratic tutor for macOS",
    "longDescription": "SocraticTutor is a desktop app that guides you through deep learning via Socratic dialogue.",
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    }
  }
}
